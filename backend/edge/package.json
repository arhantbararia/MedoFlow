    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "wrangler": "4.86.0"
  }
}
